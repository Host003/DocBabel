# ── DocBabel 离线部署环境变量（复制为 .env 后修改）────────────────────
# docker compose 会自动读取同目录 .env

# 容器/卷/网络统一前缀（多实例部署时修改）
COMPOSE_PROJECT_NAME=babeldoc

# 【建议修改】JWT 签名密钥，生产环境务必改为长随机串
SECRET_KEY=please-change-this-secret-key

# 数据库账号口令（首次启动初始化，之后修改需同步处理数据卷）
POSTGRES_USER=babeldoc
POSTGRES_PASSWORD=babeldoc
POSTGRES_DB=babeldoc

# ── 宿主机端口映射（冲突时修改）──────────────────────────────────────
# Web 访问端口（浏览器入口）
WEB_PORT=80
# 后端 API 直连端口（调试用）
BACKEND_PORT=8000
# PostgreSQL 端口（仅调试用）
# Windows 若提示 5432 绑定失败（Hyper-V 保留端口段），改为 55433
POSTGRES_PORT=5432
# Redis 端口
REDIS_PORT=6379
